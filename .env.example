PORT=3000
ALLOWED_CONTOURS=
MIN_SAMPLE_SIZE=10
CANARY_BATCH_SIZE=100
POISON_RATIO_THRESHOLD=0.1
MAX_CATEGORY_CARDINALITY=32
PRESENCE_DROP_THRESHOLD=0.05
SHORT_WINDOW_THRESHOLD=10
PROD_CONTOURS=prod
INDEXER_BASE_URL=
PLATFORM_SERVICE_TOKEN=
PLATFORM_LOGIN_URL=/login
CONSOLE_SESSION_REQUIRED=true
ENABLED_DOCUMENT_TYPES=document
PUBLISH_BATCH_SIZE=200

# Соседний микросервис (apps/test-indexer + docker compose). Пустой INDEXER_BASE_URL оставляет LocalDataModule.
# npm run infra:prepare поднимает Postgres :5434, OpenSearch :9200 и индексатор :3100.
# INDEXER_BASE_URL=http://127.0.0.1:3100
# OPENSEARCH_NODE=http://127.0.0.1:9200
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5434
# POSTGRES_USER=indexer
# POSTGRES_PASSWORD=indexer
# POSTGRES_DB=indexer
