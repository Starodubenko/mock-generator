{
  "name": "mock-generator",
  "version": "0.0.1",
  "description": "Generator of synthetic documents and HTTP mocks",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && npm run build:client && npm run build:server",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\"",
    "start": "npm run start:dev",
    "dev:vite": "vite --config vite.config.ts --port 5173",
    "dev:nest": "CONSOLE_SESSION_REQUIRED=false ALLOWED_CONTOURS=test-stand:Europe/Moscow NODE_ENV=development nest start --watch --watchAssets --preserveWatchOutput",
    "start:dev": "npx concurrently --raw -n vite,nest -c cyan,green \"npm run dev:vite\" \"npm run dev:nest\"",
    "start:dev:neighbor": "INDEXER_BASE_URL=http://127.0.0.1:3100 npm run start:dev",
    "indexer:install": "npm --prefix apps/test-indexer install",
    "indexer:start": "npm --prefix apps/test-indexer run start:dev",
    "indexer:test": "npm --prefix apps/test-indexer test",
    "compose:up": "docker compose up --build postgres opensearch test-indexer",
    "infra:prepare": "node scripts/infra-prepare.cjs",
    "start:debug": "CONSOLE_SESSION_REQUIRED=false ALLOWED_CONTOURS=test-stand:Europe/Moscow NODE_ENV=development nest start --debug --watch --watchAssets",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "aliases:apply": "node scripts/apply-layer-aliases.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./src/test/jest-e2e.config.cjs",
    "build:client": "vite build --config vite.config.ts --ssrManifest && cp src/views/index.html dist/client/index.html",
    "build:server": "vite build --config vite.config.ts --ssr src/views/entry-server.tsx"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@nestjs-ssr/react": "^0.3.30",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "http-proxy-middleware": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reconnecting-websocket": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "vite": "^8.2.1",
    "ws": "^8.22.0",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
